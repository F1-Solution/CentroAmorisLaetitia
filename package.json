{
  "name": "@amoris/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Piattaforma del Centro per la Famiglia Amoris Laetitia",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @amoris/db generate",
    "db:migrate": "pnpm --filter @amoris/db migrate",
    "db:verify": "pnpm --filter @amoris/db verify",
    "compose:up": "docker compose -f infra/compose/docker-compose.yml --env-file .env up -d",
    "compose:down": "docker compose -f infra/compose/docker-compose.yml --env-file .env down",
    "compose:reset": "docker compose -f infra/compose/docker-compose.yml --env-file .env down -v"
  },
  "devDependencies": {
    "@amoris/config": "workspace:*",
    "@types/node": "^22.18.12",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
