{
  "name": "@amoris/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Schema e migrazioni PostgreSQL (ADR-002)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "drizzle-kit generate",
    "migrate": "tsx scripts/migrate.ts",
    "verify": "tsx scripts/verify-schema.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.6",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@amoris/config": "workspace:*",
    "@types/node": "^22.18.12",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.39.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
