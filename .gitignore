# =====================================================================
# Centro per la Famiglia Amoris Laetitia
# Monorepo pnpm + Turborepo (Node/TypeScript).
#
# Sostituisce il .gitignore di Visual Studio ereditato dal progetto .NET
# abbandonato (DR-012): conteneva **/[Pp]ackages/* , che avrebbe escluso
# l'intera cartella packages/ di questo monorepo. Rischio RC-01.
# =====================================================================

# --- Sorgenti in sola lettura e dati reali: mai in Git ---
/source-private/
/source-readonly/
/.reference/

# --- Segreti ---
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.pfx

# --- Dipendenze e cache degli strumenti ---
node_modules/
.pnpm-store/
.turbo/
*.tsbuildinfo

# --- Artefatti di compilazione ---
dist/
build/
out/
.next/
next-env.d.ts

# --- Test e copertura ---
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# --- Dati dei container locali ---
/infra/compose/data/
/infra/compose/caddy-data/
/infra/compose/caddy-config/

# --- Test su dati reali dell'importer: mai in Git, mai in CI (DR-010) ---
/apps/importer/tests/real/

# --- Log ---
*.log
npm-debug.log*
pnpm-debug.log*

# --- Sistema operativo ed editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Playwright
/.playwright-mcp/

# Catture della parità visiva: contengono pagine del sito vero (DR-106).
/docs/qa/screenshots/
