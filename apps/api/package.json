{
  "name": "@amoris/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Servizio API (ADR-001: Fastify)",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "build": "node scripts/bundle.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=../../.env tools/seedSintetico.ts",
    "account:create": "tsx --env-file-if-exists=../../.env tools/createLocalAccount.ts",
    "account:unblock": "tsx --env-file-if-exists=../../.env tools/unblockAccount.ts",
    "account:reset-totp": "tsx --env-file-if-exists=../../.env tools/resetSecondFactor.ts",
    "auth:purge": "tsx --env-file-if-exists=../../.env tools/purgeAuthData.ts"
  },
  "dependencies": {
    "@amoris/blocks": "workspace:*",
    "@amoris/contracts": "workspace:*",
    "@amoris/db": "workspace:*",
    "@aws-sdk/client-s3": "^3.1131.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.5.2",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.6",
    "fastify-type-provider-zod": "^6.0.0",
    "sharp": "0.35.5",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@amoris/config": "workspace:*",
    "@types/node": "^22.18.12",
    "esbuild": "0.28.2",
    "eslint": "^9.39.0",
    "postgres": "^3.4.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
