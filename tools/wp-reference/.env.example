# Istanza WordPress di riferimento — valori locali, mai reali.
# Copiare in .env e sostituire le password con valori generati localmente.
# Il container e' esposto solo su 127.0.0.1: queste credenziali non escono dalla macchina.
WPREF_DB_ROOT_PASSWORD=cambiami-root
WPREF_DB_NAME=wpref
WPREF_DB_USER=wpref
WPREF_DB_PASSWORD=cambiami-utente
WPREF_DB_PORT=3307
WPREF_HTTP_PORT=8080
WPREF_SITE_URL=http://localhost:8080
