# =====================================================================
# Esempio d'ambiente di produzione (1F-W2 T8). Modello del file per `--env-file`:
#
#   docker compose -f infra/deploy/compose.yml --env-file <file> up -d --wait
#
# Come si usa:
# - copiare il file FUORI dal repository, con permessi 600 (solo il proprietario lo legge);
# - riempire ogni riga vuota: copiato così com'è il Compose non parte e dice quale chiave manca;
# - un segreto si genera con il comando scritto sopra la sua riga, mai a mano;
# - per lo staging: stesso modello in un file a parte, con AMORIS_ENV=staging, porte,
#   indirizzi e segreti propri (DR-296); nessun segreto in comune con la produzione.
#
# Il Compose passa ai contenitori solo le chiavi che nomina. Le righe con `#` davanti
# documentano le altre chiavi lette dalle applicazioni e dicono dove si impostano.
# =====================================================================

# --- Ambiente e immagini ---

# production o staging: sceglie il progetto Compose e il file ambiente/<valore>.env.
AMORIS_ENV=

# Registro e nome di base delle immagini, per esempio ghcr.io/<proprietario>/amoris.
IMAGE_PREFIX=

# Hash del commit delle immagini costruite dalla CI (40 caratteri).
IMAGE_TAG=

# --- Caddy e indirizzo pubblico ---

# Nome del sito senza schema: con un nome di dominio Caddy ottiene il certificato da sé.
CADDY_SITE_ADDRESS=

# Porte pubblicate sul server: 80 e 443 per la produzione.
CADDY_HTTP_PORT=
CADDY_HTTPS_PORT=

# Indirizzo pubblico del sito, con https:// e senza barra finale.
SITE_URL=

# Solo staging (DR-375): utente e hash della password davanti a tutto il sito; in produzione restano vuoti.
# Senza di loro Caddy dello staging non parte. L'hash si genera con:
#   docker run --rm -it caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d caddy hash-password
# e va scritto tra apici singoli, perché contiene `$` che il Compose altrimenti interpreta.
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_HASH=

# --- Segreti: vuoti qui, generati sul server ---

# Password del superutente del database: la usano solo `db` e `db-init`, mai le applicazioni.
# Esadecimale perché entra negli indirizzi dei collegamenti.
# Generare con: openssl rand -hex 32
POSTGRES_PASSWORD=

# Password del ruolo `amoris_owner`, proprietario degli oggetti: solo `migrate` e `restore`.
# Generare con: openssl rand -hex 32
DB_OWNER_PASSWORD=

# Password del ruolo `amoris_app` dell'API: legge e scrive i dati, nessun potere di amministrazione.
# Generare con: openssl rand -hex 32
DB_APP_PASSWORD=

# Password del ruolo `amoris_backup`: sola lettura del database, per il backup.
# Generare con: openssl rand -hex 32
DB_BACKUP_PASSWORD=

# Utente amministratore dell'archivio a oggetti: lo usano solo `objects` e `objects-init`.
# Generare con: openssl rand -hex 16
S3_ACCESS_KEY=

# Password dell'amministratore dell'archivio a oggetti.
# Generare con: openssl rand -hex 32
S3_SECRET_KEY=

# Password dell'utente `amoris-api` dell'archivio: legge e scrive solo nei due bucket (API e ripristino).
# Generare con: openssl rand -hex 32
S3_API_SECRET_KEY=

# Password dell'utente `amoris-backup` dell'archivio: legge solo i due bucket.
# Generare con: openssl rand -hex 32
S3_BACKUP_SECRET_KEY=

# Sale del digest degli indirizzi IP (almeno 32 caratteri).
# Generare con: openssl rand -hex 32
IP_HASH_SALT=

# Segreto del gettone anti-CSRF (almeno 32 caratteri).
# Generare con: openssl rand -hex 32
CSRF_SECRET=

# Chiave che cifra i segreti del secondo fattore (TOTP): 64 caratteri esadecimali, distinta dagli altri segreti.
# Perderla rende inutilizzabili i secondi fattori attivati: conservarla con gli altri segreti.
# Generare con: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# Gettone condiviso fra API e servizio di pulizia (DR-362, almeno 32 caratteri).
# Generare con: openssl rand -hex 32
SCRUB_SERVICE_TOKEN=

# --- Backup (1F-W3): solo produzione, facoltative altrove ---
# Lo staging non le imposta (DR-372): senza di esse il backup si rifiuta di partire (codice 78).

# Password del repository restic: senza di lei i backup non si leggono, tenerne una copia fuori dal
# server. Come le altre password entra nell'ambiente del contenitore (visibile con `docker inspect`).
# Generare con: openssl rand -hex 32
RESTIC_PASSWORD=

# Storage Box: nome del server, utente e cartella del repository restic.
BACKUP_SFTP_HOST=
BACKUP_SFTP_USER=
BACKUP_SFTP_PATH=

# File della chiave SSH privata e del known_hosts della Storage Box, fuori dal repository e leggibili
# dall'utente 10003 del contenitore. Predefiniti: ./backup-chiavi/ssh_key e ./backup-chiavi/known_hosts
# (relativi a infra/deploy).
# BACKUP_SSH_KEY_PATH=./backup-chiavi/ssh_key
# BACKUP_KNOWN_HOSTS_PATH=./backup-chiavi/known_hosts

# --- Facoltative del Compose: senza riga vale il predefinito scritto qui ---

# Superutente di inizializzazione e nome del database. Si fissano prima del primo avvio e poi non si cambiano.
# Porta SFTP della Storage Box.
# BACKUP_SFTP_PORT=23

# POSTGRES_USER=amoris
# POSTGRES_DB=amoris

# Bucket dell'archivio (ADR-004 §3.6).
# S3_BUCKET_PUBLIC=media-public
# S3_BUCKET_PRIVATE=media-private

# Limiti di PDF e video in byte, uguali per API e pulizia (DR-359). Stanno qui e non in
# ambiente/<valore>.env: il Compose li imposta e prevarrebbe sul file.
# MEDIA_MAX_PDF_BYTES=20971520
# MEDIA_MAX_VIDEO_BYTES=104857600

# Sottorete della rete interna `app` (Caddy, sito, area, API), da cui l'API accetta `X-Forwarded-For`.
# Produzione e staging sullo stesso server ne vogliono due diverse (per esempio 10.77.84.0/24 e 10.77.85.0/24).
# APP_SUBNET=10.77.84.0/24

# Sottorete e nome del bridge della rete `backup-out`, che `firewall/backup-out.sh` indica nelle regole dell'host.
# Il backup gira solo in produzione: basta che non collidano con APP_SUBNET e con le reti del server.
# BACKUP_OUT_SUBNET=10.77.86.0/24
# BACKUP_OUT_BRIDGE=amoris-bkp-out

# --- Fissate dal Compose o dalle immagini: non si impostano ---

# API: proxy di cui ci si fida per l'indirizzo del client; il Compose lo imposta uguale ad APP_SUBNET.
# TRUSTED_PROXY=

# API: indirizzo d'ascolto e modalità dall'immagine; database, archivio e pulizia dal Compose.
# NODE_ENV=production
# API_HOST=0.0.0.0
# API_PORT=3002
# DATABASE_URL=postgres://amoris_app:<DB_APP_PASSWORD>@db:5432/<POSTGRES_DB>
# S3_ENDPOINT=http://objects:9000
# S3_ACCESS_KEY e S3_SECRET_KEY dell'API: utente `amoris-api` e S3_API_SECRET_KEY, non l'amministratore.
# SCRUB_SERVICE_URL=http://scrub:3003

# Servizio di pulizia: indirizzo e programmi dall'immagine.
# SCRUB_HOST=0.0.0.0
# SCRUB_PORT=3003
# QPDF_PATH=/opt/qpdf/bin/qpdf
# FFMPEG_PATH=/opt/ffmpeg/bin/ffmpeg
# FFPROBE_PATH=/opt/ffmpeg/bin/ffprobe

# Sito e area: indirizzi relativi fissati nella build (DR-360), API sulla rete interna.
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_SITE_URL=
# API_URL=http://api:3002

# --- Regolazioni dell'API: in ambiente/<valore>.env, non qui ---
# Valori predefiniti dell'API. Si cambiano solo con una ragione, nel file non segreto
# dell'ambiente, che il Compose passa all'API. Il servizio di pulizia non lo legge: i suoi
# tempi massimi restano quelli predefiniti.

# LOG_LEVEL=info
# HTTP_ANON_WRITES_PER_MINUTE=30
# HTTP_PUBLIC_READ_PER_MINUTE=120
# CORS_ORIGINS=
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1
# SESSION_COOKIE_NAME=amoris_sessione
# CSRF_COOKIE_NAME=amoris_csrf
# DR-391: inattivita' 8 ore e sessione di 14 giorni, i massimi ammessi in produzione.
# SESSION_IDLE_HOURS=8
# SESSION_ABSOLUTE_DAYS=14
# DR-391: minuti di validità della conferma con password o codice per la gestione degli account.
# CONFIRMATION_MAX_MINUTES=10
# LOGIN_WINDOW_MINUTES=15
# LOGIN_MAX_PER_ACCOUNT=5
# LOGIN_MAX_PER_IP=20
# LOGIN_DELAY_STEP_MS=250
# LOGIN_DELAY_MAX_MS=2000
# LOGIN_UNIFORM_MS=350
# FORM_SUBMIT_WINDOW_MINUTES=60
# FORM_SUBMIT_MAX_PER_IP=20
# FORM_SUBMIT_MAX_PER_FORM_AND_IP=5
# FORM_SUBMIT_MIN_SECONDS=3
# S3_REGION=eu-south-1
# S3_CONNECT_TIMEOUT_MS=5000
# S3_REQUEST_TIMEOUT_MS=30000
# MEDIA_MAX_IMAGE_BYTES=20971520
# MEDIA_MAX_IMAGE_PIXELS=50000000
# MEDIA_MAX_CONCURRENT=2
# MEDIA_QUEUE_LENGTH=4
# MEDIA_IMAGE_THREADS=2
# MEDIA_WRITES_PER_MINUTE=30
# MEDIA_LOCK_TIMEOUT_MS=10000
# SCRUB_PDF_TIMEOUT_MS=30000
# SCRUB_VIDEO_TIMEOUT_MS=120000
