# Caddy di produzione e di staging (1F-W2 T6, T7): instradamento di ADR-003 §3 e intestazioni.
# Con un nome di dominio Caddy ottiene il certificato e manda HTTP su HTTPS con un 308.
# La cache dei media la decide l'API (`no-cache`, DR-365): qui nessun Cache-Control.
#
# Regola che non si viola: **qui dentro non entra nessun redirect di contenuto**.
# I redirect delle pagine allegato e dei percorsi storici sono dati in tabella e li serve
# l'applicazione (ADR-003 §3.5, requisito RC-07).

{
	admin off
}

# Controllo di salute del Compose: solo dentro il contenitore, mai pubblicato.
http://127.0.0.1:2020 {
	bind 127.0.0.1
	respond /health/live 200
}

{$CADDY_SITE_ADDRESS} {
	encode zstd gzip

	# `defer`: si applicano dopo la risposta dell'applicazione, così «?» vale davvero «solo se assente».
	header {
		defer
		X-Content-Type-Options "nosniff"
		# Solo se assente: l'anteprima e l'area impostano no-referrer e non vanno sovrascritte.
		?Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		# Durata breve e senza preload finché il passaggio a HTTPS non è verificato (W5).
		Strict-Transport-Security "max-age=3600"
		?Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		# Solo segnalazione, senza raccolta (DR-364): l'applicata si decide nella W4/W5.
		?Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; media-src 'self' blob:; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com https://player.vimeo.com https://www.google.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
		-Server
	}

	# L'area amministrativa non va indicizzata (ADR-008 §3.3 regola 2).
	# `defer`: vale anche se l'applicazione manda un suo X-Robots-Tag.
	@admin path /admin /admin/*
	header @admin {
		defer
		X-Robots-Tag "noindex, nofollow"
	}

	# Regole dell'ambiente: production.caddy o staging.caddy.
	import {$AMORIS_ENV}.caddy

	# Specifica e controlli di salute si leggono solo dall'interno (R22): da fuori 404.
	@apiInternal path /api/openapi.json* /api/health /api/health/*
	handle @apiInternal {
		respond 404
	}

	# L'API risponde dalla radice: il prefisso /api si toglie qui.
	handle_path /api/* {
		reverse_proxy api:3002
	}

	# I media li serve l'API, non lo storage (ADR-004 §3.6); i form inviati dal sito pure.
	@api path /media/* /forms/*
	handle @api {
		reverse_proxy api:3002
	}

	handle /admin* {
		reverse_proxy admin:3001
	}

	handle {
		reverse_proxy web:3000
	}
}
