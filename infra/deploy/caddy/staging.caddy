# Lo staging è dietro password (DR-375): utente e hash bcrypt vengono dall'ambiente, mai dal repository.
# I valori tra virgolette restano due argomenti anche se vuoti: manca una variabile e Caddy non parte, mai senza password.
basic_auth {
	"{$STAGING_BASIC_AUTH_USER}" "{$STAGING_BASIC_AUTH_HASH}"
}

# Lo staging non si indicizza (PLAN W5): nessuna pagina, nessun file, robots.txt che rifiuta.
header {
	defer
	X-Robots-Tag "noindex, nofollow"
}

handle /robots.txt {
	respond "User-agent: *
Disallow: /
" 200
}
