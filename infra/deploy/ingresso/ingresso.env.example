# =====================================================================
# Esempio d'ambiente dell'ingresso comune (1F-W5 T2a, DR-409). Modello del file per `--env-file`:
#
#   docker compose -f infra/deploy/ingresso/compose.yml --env-file <file> up -d --wait
#
# Copiare FUORI dal repository e riempire le righe vuote. Nessun segreto: l'ingresso non ne ha.
# =====================================================================

# Directory ACME. Prima emissione verso l'ambiente di prova (certificati non fidati dai browser, senza tetti):
#   https://acme-staging-v02.api.letsencrypt.org/directory
# Poi, verificata l'emissione, quello vero:
#   https://acme-v02.api.letsencrypt.org/directory
INGRESS_ACME_CA=

# Sottoreti delle due reti verso gli ambienti: ciascuna uguale a INGRESS_SUBNET del file dell'ambiente
# corrispondente. 10.77.88.0/24 in produzione e 10.77.89.0/24 in staging; 10.77.84-87 sono già occupate.
INGRESS_PRODUCTION_SUBNET=
INGRESS_STAGING_SUBNET=

# Nome pubblico dello staging, senza schema. Vuoto: nessun sito e nessun certificato per lo staging.
INGRESS_STAGING_NAME=

# Nome pubblico della produzione, senza schema. Vuoto fino alla 1F-W8: nessun sito e nessun certificato.
INGRESS_PRODUCTION_NAME=
